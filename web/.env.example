# FundSteward — web (Next.js)
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables (same names).

# --- Supabase (browser-safe) ---
# Use the Supabase project where you already created your tables and data.
# Dashboard: Project Settings → API → Project URL + anon public key.
# Use real values in `.env.local` only; do not commit live keys in this example file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Auth (Dashboard → Authentication → URL Configuration) ---
# Site URL (local): http://localhost:3000
# Additional redirect URLs (examples):
#   http://localhost:3000/auth/callback
#   https://<your-production-domain>/auth/callback
#   https://<your-preview>.vercel.app/auth/callback  (optional, for previews)

# --- Optional: used by some auth helpers ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (Railway API or Next server actions — never prefix with NEXT_PUBLIC) ---
# SUPABASE_SERVICE_ROLE_KEY=
